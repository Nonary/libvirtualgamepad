<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Both projects validate and normalize the same joint-build inputs. This
       proves numeric identity consistency for build-driver/package workflows;
       it does not establish an allocation or correlate unrelated manual builds. -->
  <Target Name="ValidateOwnedMouseIdentity" BeforeTargets="ClCompile">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(LvgKeyboardMouseVendorId)', '^(0[xX][0-9a-fA-F]{1,4}|[0-9]{1,5})$'))" Text="Set LvgKeyboardMouseVendorId to an explicitly owned nonzero 16-bit decimal or hexadecimal identity." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(LvgKeyboardMouseProductId)', '^(0[xX][0-9a-fA-F]{1,4}|[0-9]{1,5})$'))" Text="Set LvgKeyboardMouseProductId to an explicitly owned nonzero 16-bit decimal or hexadecimal identity." />
    <PropertyGroup>
      <_LvgVendorBase Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(LvgKeyboardMouseVendorId)', '^0[xX]'))">16</_LvgVendorBase>
      <_LvgVendorBase Condition="'$(_LvgVendorBase)' == ''">10</_LvgVendorBase>
      <_LvgProductBase Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(LvgKeyboardMouseProductId)', '^0[xX]'))">16</_LvgProductBase>
      <_LvgProductBase Condition="'$(_LvgProductBase)' == ''">10</_LvgProductBase>
      <_LvgVendorId>$([System.Convert]::ToUInt32('$(LvgKeyboardMouseVendorId)', $(_LvgVendorBase)))</_LvgVendorId>
      <_LvgProductId>$([System.Convert]::ToUInt32('$(LvgKeyboardMouseProductId)', $(_LvgProductBase)))</_LvgProductId>
    </PropertyGroup>
    <Error Condition="'$(_LvgVendorId)' == '0' Or $(_LvgVendorId) &gt; 65535 Or '$(_LvgProductId)' == '0' Or $(_LvgProductId) &gt; 65535" Text="Both owned mouse identities must be numerically nonzero and at most 65535; hexadecimal zero is not valid." />
    <ItemGroup>
      <ClCompile>
        <PreprocessorDefinitions>LVG_KM_VENDOR_ID=$(_LvgVendorId);LVG_KM_PRODUCT_ID=$(_LvgProductId);%(ClCompile.PreprocessorDefinitions)</PreprocessorDefinitions>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
